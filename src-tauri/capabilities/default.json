{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may do: reach YBT and LM Studio, open the browser to sign in, and keep its settings",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://yourbusiness.today/*" },
        { "url": "https://*.yourbusiness.today/*" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "http://localhost:*/*" }
      ]
    }
  ]
}
