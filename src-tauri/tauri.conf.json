{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YBT Desktop",
  "version": "0.1.0",
  "identifier": "today.yourbusiness.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [{ "title": "YBT Desktop", "width": 1200, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
